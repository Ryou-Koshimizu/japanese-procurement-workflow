# demo: in-process PostgreSQL (PGlite) seeded with a fictional company, and a
# fictional supplier site bundled in public/demo-supplier. No setup needed.
# live: your own PostgreSQL; catalogs are read from real supplier sites.
APP_MODE=demo
# Optional, demo only: a dedicated PostgreSQL shared by every server instance
# (needed on serverless hosts such as Vercel). It is wiped and re-seeded.
# DEMO_DATABASE_URL=

# --- live mode ---
# The exact origin people open in the browser. Used for the same-origin check,
# the Secure cookie flag and the links in emails. Use https in production.
APP_ORIGIN=http://127.0.0.1:3000
# The app must connect as a non-superuser login role that is a member of
# procurement_user and procurement_mailer and owns no tables
# (docker compose creates procurement_app for local use).
DATABASE_URL=postgresql://procurement_app:procurement_local_only@127.0.0.1:54326/procurement
ADMIN_DATABASE_URL=postgresql://postgres:postgres_local_only@127.0.0.1:54326/procurement
# Optional: send notifications by email. Without it they stay queued in the
# outbox (and appear on the 通知 page). Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=
